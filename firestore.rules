rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default deny: Block all unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Strict User Isolation: Users can ONLY access their own document and subtrees
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 3. User Notes: Only owner can create, read, update, or delete
    match /notes/{noteId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 4. Drive Items: Enforce user ownership on files & folders
    match /drive_items/{itemId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 5. Gallery Pins: Private collections protected by UID
    match /gallery_pins/{pinId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
