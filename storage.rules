rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Default deny all unmatched requests
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 2. User-specific vault: Only the authenticated owner can access their uploads
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Restrict upload size to max 25MB to prevent DOS/cost exhaustion attacks
      allow write: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
